# Copy this file to .env.local and fill in the values.

# Contact form (required for the form to send).
# Free access key from https://web3forms.com — this one is public by design.
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key

# GitHub section (both optional).
# Without a token the build uses 60 unauthenticated API requests per hour, which is plenty.
# A classic token with no scopes raises the limit to 5000/hour.
NEXT_PUBLIC_GITHUB_USERNAME=MH-Mubin
GITHUB_TOKEN=
